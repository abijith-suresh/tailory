{
  "ignoreCommand": "case \"${VERCEL_GIT_COMMIT_REF:-}\" in dependabot/*) echo 'Skipping Dependabot preview deployment'; exit 0 ;; *) exit 1 ;; esac",
  "buildCommand": "bun run build",
  "installCommand": "rm -rf node_modules && bun install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/features",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/changelog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/",
      "permanent": true
    }
  ]
}
