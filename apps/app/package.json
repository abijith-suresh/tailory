{
  "name": "tailory",
  "version": "0.0.0",
  "description": "Resume editor that runs on your computer or your server, with an MCP endpoint for agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abijith-suresh/tailory.git",
    "directory": "apps/app"
  },
  "homepage": "https://github.com/abijith-suresh/tailory/tree/main/apps/app#readme",
  "bugs": "https://github.com/abijith-suresh/tailory/issues",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tailory": "bin/tailory.mjs"
  },
  "files": [
    "bin",
    "dist",
    "drizzle"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "dev",
    "provenance": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node bin/tailory.mjs",
    "type-check": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "pack:tarball": "node scripts/pack.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"console.error('tailory is published by the Dev build workflow, not from a checkout.'); process.exit(1)\"",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "npx --yes auth@1.7.28 generate --config auth-cli.config.ts --output src/server/db/auth-schema.ts --yes && biome format --write src/server/db/auth-schema.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0"
  },
  "devDependencies": {
    "@better-auth/cimd": "^1.7.28",
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@better-auth/mcp": "^1.7.28",
    "@better-auth/oauth-provider": "^1.7.28",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.4",
    "@tailory/core": "*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.4",
    "@types/pdfmake": "^0.3.3",
    "@vitest/coverage-v8": "5.1.1",
    "better-auth": "^1.7.28",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^31.0.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.15",
    "postgres": "^4.1.1",
    "solid-js": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
