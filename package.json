{
  "name": "tailory",
  "type": "module",
  "version": "0.6.1",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^7.2.4",
    "geist": "^1.7.2",
    "idb": "^8.0.3",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "pdfmake": "^0.3.11",
    "solid-js": "^1.9.15",
    "solid-transition-group": "^0.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/pdfmake": "^0.3.3",
    "@vitest/ui": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
