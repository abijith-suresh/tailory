{
  "name": "tailory",
  "private": true,
  "type": "module",
  "version": "0.0.2",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tailory/site --",
    "dev:app": "npm run dev --workspace tailory --",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @tailory/site --",
    "type-check": "npm run type-check --workspaces --if-present",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run test --workspaces --if-present --",
    "test:coverage": "npm run test:coverage --workspaces --if-present --",
    "test:e2e": "npm run test:e2e --workspace @tailory/site --",
    "test:e2e:build": "npm run build && npm run test:e2e",
    "assets:pdf-worker": "npm run assets:pdf-worker --workspace @tailory/site",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2"
  }
}
