---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title = "Tailory",
  description = "A resume editor that runs in your browser. Import a PDF, DOCX, or JSON resume, edit it with a live preview, and export a text PDF or JSON.",
  ogImage = "/og.png",
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
  noindex = false,
} = Astro.props;

const pageTitle =
  title === "Tailory" || title.startsWith("Tailory ·") || title.endsWith(" · Tailory")
    ? title
    : `${title} · Tailory`;

const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow"} />
    <meta name="theme-color" content="#e7e8e6" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tailory" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tailory: the headline The resume editor that stays in your browser, beside a resume page resting on a tape measure."
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface font-sans text-ink antialiased">
    <slot />
  </body>
</html>
