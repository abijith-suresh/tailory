---
import ExternalIcon from "@/components/site/ExternalIcon.astro";
import Logo from "@/components/site/Logo.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = "Tailory", description, noindex } = Astro.props;

const repoUrl = "https://github.com/abijith-suresh/tailory";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "FAQ", href: "/faq" },
  { label: "Privacy", href: "/privacy" },
];

const footerLinks = [
  ...navLinks,
  { label: "GitHub", href: repoUrl, external: true },
  { label: "Report an issue", href: `${repoUrl}/issues`, external: true },
];
---

<Layout title={title} description={description} noindex={noindex}>
  <div class="flex min-h-screen flex-col bg-canvas text-fg">
    <a
      href="#main"
      class="sr-only z-50 rounded-button bg-fg px-4 py-2 text-ui-sm text-canvas focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <header class="site-x">
      <nav class="flex h-16 items-center gap-1 md:gap-2" aria-label="Main">
        <a href="/" class="mr-auto flex min-h-11 items-center rounded-sm" aria-label="Tailory home">
          <Logo />
        </a>
        <!-- Phones show only the logo and the editor; FAQ and Privacy are in the footer. -->
        <ul class="flex items-center gap-1 max-sm:hidden">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={path === link.href ? "page" : undefined}
                  class="btn-quiet h-11 px-3 text-ui-sm underline-offset-8 md:h-9 aria-[current=page]:underline aria-[current=page]:decoration-primary aria-[current=page]:decoration-2"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/editor" class="btn-primary h-11 px-4 text-ui-sm sm:ml-2 md:h-9">
          Open editor
        </a>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <!-- Phones stack the logo, the links and the licence. From md, one row on a shared baseline. -->
    <footer class="border-t border-line">
      <div
        class="site-x flex flex-col items-start gap-4 pt-6 pb-8 text-body-sm text-fg-muted md:flex-row md:items-baseline md:gap-x-6 md:pb-6"
      >
        <a href="/" class="flex min-h-11 items-center rounded-sm" aria-label="Tailory home">
          <Logo />
        </a>
        <nav class="md:order-last md:ml-auto" aria-label="Footer">
          <ul class="grid grid-cols-[auto_auto] gap-x-10 sm:flex sm:gap-x-6">
            {
              footerLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    aria-current={path === link.href ? "page" : undefined}
                    class="inline-flex min-h-11 items-center gap-1 underline-offset-4 transition-colors hover:text-fg max-sm:min-w-11 aria-[current=page]:text-fg aria-[current=page]:underline aria-[current=page]:decoration-primary aria-[current=page]:decoration-2"
                  >
                    {link.label}
                    {link.external && <ExternalIcon />}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p>MIT licensed</p>
      </div>
    </footer>
  </div>
</Layout>
