---
import ExternalIcon from "@/components/site/ExternalIcon.astro";
import Logo from "@/components/site/Logo.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = "Tailory", description, noindex } = Astro.props;

const repoUrl = "https://github.com/abijith-suresh/tailory";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "FAQ", href: "/faq" },
  { label: "Privacy", href: "/privacy" },
];

const footerGroups = [
  {
    title: "Product",
    links: [
      { label: "Editor", href: "/editor" },
      { label: "FAQ", href: "/faq" },
      { label: "Releases", href: `${repoUrl}/releases`, external: true },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: repoUrl, external: true },
      { label: "Report an issue", href: `${repoUrl}/issues`, external: true },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
];
---

<Layout title={title} description={description} noindex={noindex}>
  <div class="flex min-h-screen flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only z-50 rounded-control bg-ink px-4 py-2 text-meta text-on-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-line bg-paper/92 backdrop-blur-sm">
      <nav
        class="mx-auto flex h-16 max-w-page items-center gap-6 px-gutter md:px-gutter-wide"
        aria-label="Main"
      >
        <a href="/" class="mr-auto rounded-control" aria-label="Tailory home">
          <Logo />
        </a>

        <ul class="hidden items-center gap-7 md:flex">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={path === link.href ? "page" : undefined}
                  class="text-meta font-medium text-ink-muted underline-offset-[6px] transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-meta font-medium text-ink-muted transition-colors hover:text-ink"
            >
              GitHub <ExternalIcon />
            </a>
          </li>
        </ul>

        <a
          href="/editor"
          class="inline-flex h-9 items-center rounded-control bg-ink px-4 text-meta font-semibold text-on-ink transition-colors hover:bg-accent-strong"
        >
          Open editor
        </a>

        <button
          id="menu-button"
          type="button"
          class="-mr-2 flex size-10 items-center justify-center rounded-control text-ink md:hidden"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="menu-panel"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="size-5">
            <path
              class="menu-icon-open"
              d="M3 6h14M3 10h14M3 14h14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
            <path
              class="menu-icon-close"
              d="M5 5l10 10M15 5 5 15"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </nav>

      <div id="menu-panel" class="border-t border-line md:hidden" hidden>
        <ul class="mx-auto flex max-w-page flex-col px-gutter py-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={path === link.href ? "page" : undefined}
                  class="flex h-12 items-center text-body font-medium text-ink-muted aria-[current=page]:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-12 items-center gap-1.5 text-body font-medium text-ink-muted"
            >
              GitHub <ExternalIcon />
            </a>
          </li>
        </ul>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto grid max-w-page gap-10 px-gutter py-12 md:grid-cols-[1fr_auto] md:px-gutter-wide md:py-14"
      >
        <div class="max-w-xs">
          <a href="/" class="inline-block rounded-control" aria-label="Tailory home">
            <Logo />
          </a>
          <p class="mt-4 text-meta text-ink-muted">A resume editor that runs in your browser.</p>
          <p class="mt-1 text-meta text-ink-subtle">Open source, MIT license.</p>
        </div>

        <div class="grid grid-cols-2 gap-x-10 gap-y-8 sm:grid-cols-3 sm:gap-x-14">
          {
            footerGroups.map((group) => (
              <div>
                <h2 class="text-label font-semibold text-ink">{group.title}</h2>
                <ul class="mt-3 space-y-2">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        class="inline-flex items-center gap-1 text-meta text-ink-muted transition-colors hover:text-ink"
                      >
                        {link.label}
                        {link.external && <ExternalIcon />}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  #menu-button[aria-expanded="false"] .menu-icon-close,
  #menu-button[aria-expanded="true"] .menu-icon-open {
    display: none;
  }
</style>

<script>
  // ClientRouter swaps the page on navigation, so bind element listeners on every page load.
  // The document outlives navigations, so the Escape listener is added once.
  const getMenu = () => ({
    button: document.getElementById("menu-button"),
    panel: document.getElementById("menu-panel"),
  });

  const setMenuOpen = (open: boolean) => {
    const { button, panel } = getMenu();
    if (!button || !panel) return;
    button.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  };

  document.addEventListener("astro:page-load", () => {
    const { button } = getMenu();
    button?.addEventListener("click", () => {
      setMenuOpen(button.getAttribute("aria-expanded") !== "true");
    });
  });

  document.addEventListener("keydown", (event) => {
    const { button } = getMenu();
    if (event.key !== "Escape" || button?.getAttribute("aria-expanded") !== "true") return;
    setMenuOpen(false);
    button.focus();
  });
</script>
