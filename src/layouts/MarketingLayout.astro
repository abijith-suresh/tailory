---
import ExternalIcon from "@/components/site/ExternalIcon.astro";
import Logo from "@/components/site/Logo.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = "Tailory", description, noindex } = Astro.props;

const repoUrl = "https://github.com/abijith-suresh/tailory";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "FAQ", href: "/faq" },
  { label: "Privacy", href: "/privacy" },
];

const footerLinks = [
  { label: "GitHub", href: repoUrl },
  { label: "Report an issue", href: `${repoUrl}/issues` },
];
---

<Layout title={title} description={description} noindex={noindex}>
  <div class="flex min-h-screen flex-col bg-surface text-ink">
    <a
      href="#main"
      class="sr-only z-50 rounded-button-sm bg-ink px-4 py-2 text-ui-sm text-surface focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-rule bg-surface/95 backdrop-blur-sm">
      <nav
        class="mx-auto flex h-15 max-w-page items-center gap-4 px-4 md:gap-8 md:px-10"
        aria-label="Main"
      >
        <a href="/" class="mr-auto flex rounded-xs" aria-label="Tailory home">
          <Logo compact />
        </a>

        <ul class="flex items-center gap-4 md:gap-8">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={path === link.href ? "page" : undefined}
                  class="inline-flex min-h-11 items-center text-ui-sm text-ink-muted underline-offset-8 transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-1"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a href="/editor" class="btn-primary h-11 px-4 text-ui-sm md:h-9">Open editor</a>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-page px-4 md:px-10">
      <div
        class="flex flex-wrap items-center justify-between gap-x-12 gap-y-6 border-t border-rule pt-10 pb-12 md:pb-16"
      >
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="/" class="inline-flex rounded-xs" aria-label="Tailory home">
            <Logo />
          </a>
          <p class="text-body-sm text-ink-subtle">MIT licensed, provided as is.</p>
        </div>

        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-8">
            {
              footerLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-1 text-ui-sm text-ink-muted transition-colors hover:text-ink"
                  >
                    {link.label}
                    <ExternalIcon />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>
  </div>
</Layout>
