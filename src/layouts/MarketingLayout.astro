---
import ExternalIcon from "@/components/site/ExternalIcon.astro";
import Logo from "@/components/site/Logo.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = "Tailory", description, noindex } = Astro.props;

const repoUrl = "https://github.com/abijith-suresh/tailory";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "FAQ", href: "/faq" },
  { label: "Privacy", href: "/privacy" },
];

const footerLinks = [
  { label: "GitHub", href: repoUrl },
  { label: "Report an issue", href: `${repoUrl}/issues` },
];
---

<Layout title={title} description={description} noindex={noindex}>
  <div class="flex min-h-screen flex-col bg-canvas text-fg">
    <a
      href="#main"
      class="sr-only z-50 rounded-button bg-fg px-4 py-2 text-ui-sm text-canvas focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <header class="site-x">
      <nav class="flex h-16 items-center gap-1 md:gap-2" aria-label="Main">
        <a href="/" class="mr-auto flex min-h-11 items-center rounded-sm" aria-label="Tailory home">
          <Logo compact />
        </a>
        <ul class="flex items-center gap-1">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={path === link.href ? "page" : undefined}
                  class="btn-quiet h-11 px-3 text-ui-sm underline-offset-8 md:h-9 aria-[current=page]:underline aria-[current=page]:decoration-primary aria-[current=page]:decoration-2"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/editor" class="btn-primary ml-1 h-11 px-4 text-ui-sm md:ml-2 md:h-9">
          Open editor
        </a>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <!-- Phones: the logo and licence share a row, with the links below. From md, one row. -->
    <footer class="border-t border-line">
      <div
        class="site-x grid grid-cols-[1fr_auto] items-center py-6 max-md:pb-8 md:flex md:justify-between md:gap-12"
      >
        <a href="/" class="flex min-h-11 w-fit items-center rounded-sm" aria-label="Tailory home">
          <Logo />
        </a>
        <div class="contents text-body-sm text-fg-muted md:flex md:items-center md:gap-3">
          <p>MIT licensed</p>
          <span class="max-md:hidden" aria-hidden="true">·</span>
          <nav class="col-span-2" aria-label="Footer">
            <ul class="flex flex-wrap items-center gap-x-3">
              {
                footerLinks.map((link, i) => (
                  <li class="flex items-center gap-x-3">
                    {i > 0 && <span aria-hidden="true">·</span>}
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-11 items-center gap-1 transition-colors hover:text-fg"
                    >
                      {link.label}
                      <ExternalIcon />
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </div>
</Layout>
