---
import PageIntro from "@/components/site/PageIntro.astro";
import ProseSection from "@/components/site/ProseSection.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

const repoUrl = "https://github.com/abijith-suresh/tailory";
---

<MarketingLayout title="Terms" description="Tailory's terms of use: MIT licensed, provided as is.">
  <PageIntro
    title="Terms"
    lead="Tailory is open-source software under the MIT license."
    meta="Last updated November 19, 2026"
  />
  <div class="mx-auto max-w-[44rem] px-gutter pb-section">
    <ProseSection title="License">
      <p>
        You can use, copy, change, and share Tailory under the MIT license. The full text is in the <a
          href={`${repoUrl}/blob/main/LICENSE`}
          target="_blank"
          rel="noopener noreferrer">repository</a
        >.
      </p>
    </ProseSection>

    <ProseSection title="No warranty">
      <p>
        Tailory is provided as is, without warranty of any kind. Its authors aren't liable for any
        loss that comes from using it. Check your exported resume before you send it.
      </p>
    </ProseSection>

    <ProseSection title="Your content">
      <p>What you write is yours. Tailory never receives it.</p>
    </ProseSection>

    <ProseSection title="Changes">
      <p>
        Changes to these terms are published in the <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer">GitHub repository</a
        >.
      </p>
    </ProseSection>
  </div>
</MarketingLayout>
