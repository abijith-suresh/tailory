---
import HeroVisual from "@/components/site/HeroVisual.astro";
import ProseSection from "@/components/site/ProseSection.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

const imports = [
  {
    format: "JSON",
    how: "The most reliable. Tailory reads each supported section field by field.",
  },
  { format: "DOCX", how: "Tailory reads the text and sorts it into sections. Check them after." },
  {
    format: "PDF",
    how: "Best effort, and text PDFs only. A scanned PDF is a picture of text, which Tailory can’t read.",
  },
];
---

<MarketingLayout
  title="Tailory · The resume editor that stays in your browser"
  description="Import a PDF, DOCX, or JSON resume, edit it with a live preview, and export a PDF or JSON. Your resume stays in your browser."
>
  <!-- Hero: the headline, one line, one action, then the document itself. -->
  <section class="mx-auto max-w-page px-gutter pt-12 md:px-gutter-wide md:pt-20">
    <h1 class="max-w-[13em] font-serif text-display font-normal text-balance">
      The resume editor that stays in your browser.
    </h1>
    <p class="mt-5 text-lead text-ink-muted md:mt-6">No account, no upload. Free and open source.</p>
    <a href="/editor" class="btn-primary mt-7 h-12 px-6 text-body">Open editor</a>

    <div class="mt-16 md:mt-20">
      <HeroVisual />
    </div>
  </section>

  <div class="mx-auto max-w-page px-gutter pt-section pb-16 md:px-gutter-wide md:pb-24">
    <div class="border-t border-ink" aria-hidden="true"></div>

    <ProseSection title="Start from what you have">
      <p>
        Open a PDF, DOCX, or JSON resume, up to 10&nbsp;MB. Tailory reads it in this tab and fills in the
        sections. Or start from a blank page.
      </p>
    </ProseSection>

    <ProseSection title="Edit with a live preview">
      <p>
        Each section has its own form, and the preview updates as you type. Switch templates at any
        time without retyping.
      </p>
    </ProseSection>

    <ProseSection title="Export a PDF or JSON">
      <p>
        The PDF holds selectable text, not a picture of it. JSON keeps your content, so you can open
        it in Tailory again.
      </p>
    </ProseSection>

    <ProseSection title="Saved in this browser">
      <p>
        Your work autosaves, and you can keep named drafts. Both live in this browser’s storage, so
        clearing site data deletes them. Export JSON to keep a copy.
      </p>
    </ProseSection>

    <ProseSection title="What imports well">
      <dl class="divide-y divide-rule">
        {
          imports.map((item) => (
            <div class="grid gap-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-4">
              <dt class="font-medium">{item.format}</dt>
              <dd class="text-ink-muted">{item.how}</dd>
            </div>
          ))
        }
      </dl>
    </ProseSection>
  </div>
</MarketingLayout>
