---
import ExternalIcon from "@/components/site/ExternalIcon.astro";
import HeroVisual from "@/components/site/HeroVisual.astro";
import ResumeSheet from "@/components/site/ResumeSheet.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import type { TemplateId } from "@/types/template";

const templates: { id: TemplateId; name: string; text: string }[] = [
  { id: "modern", name: "Modern", text: "A ruled header and lines between sections." },
  { id: "minimal", name: "Minimal", text: "Type and space, no decoration." },
  { id: "compact-ats", name: "Compact", text: "Tighter spacing to fit more on a page." },
];

const drafts = [
  { name: "Design roles", saved: "11/18/2026, 9:42 AM" },
  { name: "Short version", saved: "11/12/2026, 6:05 PM" },
  { name: "Agency roles", saved: "10/30/2026, 8:17 AM" },
];
---

<MarketingLayout
  title="Tailory · The resume editor that stays in your browser"
  description="Import a PDF, DOCX, or JSON resume, edit it with a live preview, and export a text PDF or JSON. Your resume stays in your browser."
>
  <!-- Hero -->
  <section
    class="mx-auto grid max-w-page gap-x-16 gap-y-8 px-gutter pt-12 md:px-gutter-wide md:pt-20 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-end"
  >
    <div>
      <p class="label text-accent-ink">Resume editor · Free and open source</p>
      <h1 class="mt-5 max-w-[15ch] font-serif text-display font-normal text-balance">
        The resume editor that stays in <em class="font-light">your browser.</em>
      </h1>
    </div>

    <div class="border-t border-rule pt-6 lg:mb-3 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-7">
      <p class="max-w-[34rem] text-lead text-ink-muted">
        Import a PDF, DOCX, or JSON resume, edit it with a live preview, and export a text PDF. No
        account, no upload.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a href="/editor" class="btn-primary h-12 px-6 text-body">Open editor</a>
        <a
          href="https://github.com/abijith-suresh/tailory"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline inline-flex items-center gap-1.5 text-body font-medium"
        >
          View the source <ExternalIcon class="size-3.5" />
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-page px-gutter pt-14 pb-section md:px-gutter-wide md:pt-16">
    <HeroVisual />
  </div>

  <!-- Templates -->
  <section class="border-y border-rule bg-surface-sunken" aria-labelledby="templates-title">
    <div class="mx-auto max-w-page px-gutter py-section md:px-gutter-wide">
      <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end md:gap-10">
        <h2 id="templates-title" class="font-serif text-headline font-normal text-balance">
          Three templates. <em class="font-light">Switch any time.</em>
        </h2>
        <p class="max-w-md text-body text-ink-muted md:justify-self-end">
          Your content carries over when you switch.
        </p>
      </div>

      <ul class="specimens mt-12 grid grid-cols-3 gap-3 sm:gap-6 lg:gap-10">
        {
          templates.map((template, index) => (
            <li class="flex flex-col items-center">
              <ResumeSheet template={template.id} class="specimens__sheet" />
              <p class="mt-5 flex items-baseline gap-2 self-stretch border-t border-rule-strong pt-3 sm:mt-6">
                <span class="label hidden text-ink-subtle sm:inline">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="font-serif text-[1.125rem] leading-tight sm:text-title">
                  {template.name}
                </span>
              </p>
              <p class="mt-1 hidden self-stretch text-meta text-ink-muted sm:block">
                {template.text}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Privacy -->
  <section
    class="mx-auto grid max-w-page gap-12 px-gutter py-section md:grid-cols-2 md:px-gutter-wide lg:gap-24"
    aria-labelledby="privacy-title"
  >
    <div class="max-w-md">
      <p class="label text-accent-ink">Privacy</p>
      <h2 id="privacy-title" class="mt-4 font-serif text-headline font-normal text-balance">
        Your resume stays in this browser.
      </h2>
      <p class="mt-5 text-body text-ink-muted">
        Tailory saves as you type and keeps named drafts on this device. Clearing site data deletes
        them, so export JSON when you want a copy.
      </p>
      <a href="/privacy" class="link-underline mt-6 inline-block text-body font-medium">
        Privacy policy
      </a>
    </div>

    <div class="drafts self-center" aria-hidden="true">
      <div class="flex items-baseline justify-between gap-4 pb-3">
        <p class="font-serif text-title">Saved drafts</p>
        <p class="label text-ink-subtle">This browser</p>
      </div>
      <div class="rule-double"></div>
      <ul>
        {
          drafts.map((draft) => (
            <li class="drafts__row">
              <span class="font-serif text-[1.0625rem]">{draft.name}</span>
              <span class="drafts__leader" />
              <span class="text-meta whitespace-nowrap text-ink-muted tabular-nums">
                {draft.saved}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Call to action -->
  <section class="mx-auto max-w-page px-gutter pb-section md:px-gutter-wide">
    <div class="border-t border-rule pt-section text-center">
      <h2 class="mx-auto max-w-[18ch] font-serif text-headline font-normal text-balance">
        Start with the resume you have.
      </h2>
      <p class="mt-4 text-body text-ink-muted">No account, nothing to install.</p>
      <a href="/editor" class="btn-primary mt-8 h-12 px-6 text-body">Open editor</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .specimens :global(.specimens__sheet) {
    --sheet-scale: 0.13;
  }

  @media (min-width: 25rem) {
    .specimens :global(.specimens__sheet) {
      --sheet-scale: 0.155;
    }
  }

  @media (min-width: 40rem) {
    .specimens :global(.specimens__sheet) {
      --sheet-scale: 0.25;
    }
  }

  @media (min-width: 48rem) {
    .specimens :global(.specimens__sheet) {
      --sheet-scale: 0.3;
    }
  }

  @media (min-width: 64rem) {
    .specimens :global(.specimens__sheet) {
      --sheet-scale: 0.4;
    }
  }

  @media (min-width: 80rem) {
    .specimens :global(.specimens__sheet) {
      --sheet-scale: 0.45;
    }
  }

  .drafts__row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  /* Dot leaders, as in a table of contents. */
  .drafts__leader {
    flex: 1 1 auto;
    min-width: 1rem;
    height: 1px;
    background-image: radial-gradient(circle, var(--color-rule-strong) 1px, transparent 1.2px);
    background-size: 6px 2px;
    background-repeat: repeat-x;
  }
</style>
