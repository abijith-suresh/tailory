---
import VersionBoard from "@/components/site/VersionBoard.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

const points = [
  {
    title: "Start from what you have",
    text: "Open a PDF, DOCX or JSON resume. Tailory reads it in this tab and fills in the sections.",
  },
  {
    title: "One master, many versions",
    text: "Each job gets its own version. Edit a role once and every version that uses it updates.",
  },
  {
    title: "Export a real PDF",
    text: "Selectable text, set to the page count you choose. Or export JSON and pick it up again later.",
  },
];

const imports = [
  { format: "JSON", how: "Read field by field. The most reliable." },
  { format: "DOCX", how: "Text sorted into sections. Check them after." },
  { format: "PDF", how: "Text PDFs only, best effort. Scanned pages can’t be read." },
];
---

<MarketingLayout
  title="Tailory · Cut your resume to fit the job"
  description="Keep your whole career in one place and choose what goes into each application. Import a PDF, DOCX or JSON resume and export a text PDF. Nothing leaves your browser."
>
  <section
    class="site-x grid gap-10 pt-10 pb-16 md:gap-12 md:pt-16 md:pb-20 xl:grid-cols-[minmax(0,--spacing(72))_minmax(0,1fr)] xl:items-center"
  >
    <div class="lg:grid lg:grid-cols-2 lg:items-end lg:gap-12 xl:block">
      <h1
        class="max-w-measure text-heading-3 text-balance max-[24rem]:text-heading-4 md:text-heading-1"
      >
        Cut your resume to fit the job.
      </h1>
      <div>
        <p class="mt-4 max-w-measure text-body-lg text-pretty text-fg-muted md:mt-6 lg:mt-0 xl:mt-6">
          Keep your whole career in one place, then choose what goes into each application. No
          account, and nothing leaves your browser.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3 lg:mt-6 xl:mt-8">
          <a href="/editor" class="btn-primary h-11 px-4 text-ui-sm md:h-9">Open editor</a>
          <a href="/editor" class="btn-quiet h-11 px-4 text-ui-sm md:h-9">
            Import a resume <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <VersionBoard />
  </section>

  <section class="border-t border-line">
    <div class="site-x grid gap-8 py-12 md:grid-cols-3 md:gap-12 md:py-16">
      {
        points.map((point) => (
          <div>
            <h2 class="text-heading-6 text-balance">{point.title}</h2>
            <p class="mt-2 max-w-measure text-body-md text-pretty text-fg-muted">{point.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line">
    <div class="site-x py-12 md:py-16">
      <div class="split gap-y-4 md:items-baseline">
        <h2 class="text-heading-5 text-balance">What imports well</h2>
        <dl class="grid grid-cols-[--spacing(20)_minmax(0,1fr)] text-body-md md:grid-cols-[--spacing(24)_minmax(0,1fr)]">
          {
            imports.map((item) => (
              <>
                <dt class="border-b border-line py-3 text-ui-md">{item.format}</dt>
                <dd class="border-b border-line py-3 text-pretty text-fg-muted">{item.how}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</MarketingLayout>
