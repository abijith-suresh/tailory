---
import HeroVisual from "@/components/site/HeroVisual.astro";
import Tape from "@/components/site/Tape.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

const steps = [
  "Open a PDF, DOCX, or JSON resume, or start from a blank page.",
  "Edit each section in a form. The preview updates as you type.",
  "Export a PDF with selectable text, or JSON to open again later.",
];
---

<MarketingLayout
  title="Tailory · The resume editor that stays in your browser"
  description="Import a PDF, DOCX, or JSON resume, edit it with a live preview, and export a PDF or JSON. Your resume stays in your browser."
>
  <!-- Hero: the headline across the full measure, saved drafts rising beneath it. -->
  <section class="mx-auto max-w-page px-gutter pt-10 md:px-gutter-wide md:pt-16">
    <h1 class="font-serif text-display font-normal text-balance">
      The resume editor that stays in your browser.
    </h1>

    <div class="mt-8 grid gap-x-10 gap-y-12 md:mt-12 md:grid-cols-3">
      <div class="flex flex-col gap-12">
        <div>
          <p class="text-lead text-balance text-ink-muted">
            No account, no upload. Free and open source.
          </p>
          <a href="/editor" class="btn-primary mt-6 h-12 px-6 text-body">Open editor</a>
        </div>

        <div class="max-w-[34ch]">
          <h2 class="font-serif text-title font-medium">Open, edit, export</h2>
          <ol class="mt-3 space-y-2 text-body text-ink-muted">
            {steps.map((step) => <li>{step}</li>)}
          </ol>
        </div>

        <div class="max-w-[34ch]">
          <h2 class="font-serif text-title font-medium">Autosave and drafts</h2>
          <p class="mt-3 text-body text-ink-muted">
            Your work autosaves in this browser, and you can keep named drafts. Clearing site data
            deletes them, so export JSON to keep a copy.
          </p>
        </div>
      </div>

      <div class="md:col-span-2">
        <HeroVisual />
      </div>
    </div>
  </section>

  <!-- The tape measures the front sheet: zero on its left edge, 8½ on its right. -->
  <Tape class="home-tape" start="sheet" zero={0} mark={8.5} />
</MarketingLayout>

<style>
  /* The front sheet tucks its blank foot under the tape. */
  :global(.home-tape) {
    z-index: 1;
    margin-top: -0.75rem;
    margin-bottom: var(--spacing-section);
  }
</style>
