---
import Tape from "@/components/site/Tape.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
---

<MarketingLayout title="Page not found" description="This page doesn’t exist." noindex>
  <section class="mx-auto max-w-page px-gutter pt-12 md:px-gutter-wide md:pt-20">
    <h1 class="max-w-[14ch] font-serif text-display font-normal text-balance">
      This page isn’t here.
    </h1>
    <p class="mt-6 max-w-md text-lead text-ink-muted">
      The link may be out of date. Your drafts are still in this browser.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a href="/editor" class="btn-primary h-12 px-6 text-body">Open editor</a>
      <a href="/" class="link-underline text-body font-medium">Home page</a>
    </div>
  </section>

  <div class="not-found__tape">
    <Tape from={396} length={60} mark={404} />
  </div>
</MarketingLayout>

<style>
  /* The tape starts off the left edge so the 404 inch line falls on the text column's edge. */
  .not-found__tape {
    margin-block: 4rem;
    overflow-x: clip;
  }

  .not-found__tape :global(.tape) {
    width: 200rem;
    margin-left: calc(var(--spacing-gutter) - 32rem);
    transform: rotate(-1.5deg);
    transform-origin: 32rem 50%;
  }

  @media (min-width: 48rem) {
    .not-found__tape {
      margin-top: 6rem;
    }
    .not-found__tape :global(.tape) {
      margin-left: calc(
        max(var(--spacing-gutter-wide), (100% - var(--container-page)) / 2 + var(--spacing-gutter-wide)) - 32rem
      );
    }
  }
</style>
