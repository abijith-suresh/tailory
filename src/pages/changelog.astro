---
import changelogSource from "../../CHANGELOG.md?raw";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

type ReleaseSection = { title: string; items: string[] };
type Release = { version: string; date: string; sections: ReleaseSection[] };

function parseChangelog(source: string): Release[] {
  const releases: Release[] = [];
  const releaseMatches = [
    ...source.matchAll(/^## \[(?!Unreleased)([^\]]+)\] - (\d{4}-\d{2}-\d{2})$/gm),
  ];

  for (const [index, match] of releaseMatches.entries()) {
    const [, version, date] = match;
    const start = (match.index ?? 0) + match[0].length + 1;
    const end =
      index + 1 < releaseMatches.length
        ? (releaseMatches[index + 1].index ?? source.length)
        : source.length;
    const body = source.slice(start, end).trim();
    const sections: ReleaseSection[] = [];
    const sectionMatches = [...body.matchAll(/^### ([^\n]+)$/gm)];

    for (const [sectionIndex, sectionMatch] of sectionMatches.entries()) {
      const [, title] = sectionMatch;
      const sectionStart = (sectionMatch.index ?? 0) + sectionMatch[0].length + 1;
      const sectionEnd =
        sectionIndex + 1 < sectionMatches.length
          ? (sectionMatches[sectionIndex + 1].index ?? body.length)
          : body.length;
      const sectionBody = body.slice(sectionStart, sectionEnd).trim();
      const items = sectionBody
        .split("\n")
        .filter((line) => line.startsWith("- "))
        .map((line) => line.slice(2));

      if (items.length > 0) sections.push({ title, items });
    }

    releases.push({ version, date, sections });
  }

  return releases;
}

const releases = parseChangelog(changelogSource);

function formatDate(date: string) {
  return new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<MarketingLayout
  title="Changelog — Tailory"
  description="Tailory version history derived from the canonical changelog."
>
  <section class="mx-auto max-w-6xl px-8 pb-16 pt-24" data-reveal>
    <p class="mb-6 text-xs font-medium uppercase tracking-[0.25em] text-[#a0b8ab]">Changelog</p>
    <h1
      class="max-w-2xl leading-[1.1] text-[#0e2418]"
      style="font-family: 'Lora', Georgia, serif; font-size: clamp(36px, 4.5vw, 56px); font-weight: 700"
    >
      What's changed.
    </h1>
    <div class="mt-8 h-px w-20 bg-[#ccddd4]"></div>
  </section>

  <section class="mx-auto max-w-4xl px-8 pb-24">
    <div class="space-y-12">
      {
        releases.map((release, i) => (
          <article
            class="border-t border-[#ccddd4] py-12"
            data-reveal
            data-reveal-delay={String(Math.min(i * 100, 300))}
          >
            <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:justify-between">
              <div>
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#a0b8ab]">
                  {formatDate(release.date)}
                </p>
                <h2
                  class="mt-2 text-2xl font-bold text-[#1d6648]"
                  style="font-family: 'Lora', Georgia, serif"
                >
                  {release.version}
                </h2>
              </div>
              {i === 0 && (
                <span class="inline-block rounded-full bg-[#1d6648]/10 px-2.5 py-0.5 text-xs font-medium text-[#1d6648]">
                  Latest
                </span>
              )}
            </div>

            <div class="mt-6 space-y-6">
              {release.sections.map((section) => (
                <section>
                  <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6d8f7e]">
                    {section.title}
                  </h3>
                  <ul class="mt-3 space-y-3">
                    {section.items.map((item) => (
                      <li class="flex gap-3 text-base leading-relaxed text-[#3d6650]">
                        <span class="mt-1 shrink-0 text-xs text-[#1d6648]">→</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</MarketingLayout>
