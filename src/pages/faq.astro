---
import PageIntro from "@/components/site/PageIntro.astro";
import ProseSection from "@/components/site/ProseSection.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

const repoUrl = "https://github.com/abijith-suresh/tailory";

const faqs = [
  {
    q: "Is Tailory free?",
    a: "Yes. The source is on GitHub under the MIT license.",
  },
  {
    q: "Does my resume leave my browser?",
    a: "No. Import, editing, preview, and export all run in the tab. Tailory has no server that receives resume content.",
  },
  {
    q: "Which files can I import?",
    a: "PDF, DOCX, and JSON, up to 10 MB. Scanned PDFs hold pictures of text, so Tailory can’t read them.",
  },
  {
    q: "Can I start without a file?",
    a: "Yes. Open the editor and fill in the sections.",
  },
  {
    q: "Does it work with JSON Resume?",
    a: "Tailory imports and exports JSON Resume-style data for the sections it supports. It doesn’t check files against the official schema.",
  },
  {
    q: "Where are my drafts saved?",
    a: "In this browser’s storage for the site. Clearing site data deletes them, so export JSON to keep a copy.",
  },
  {
    q: "Can I change the template?",
    a: "Yes. Pick one above the preview in the editor. Your content carries over.",
  },
  {
    q: "Will hiring software read my PDF?",
    a: "Tailory can’t promise how an employer’s software reads a resume. The exported PDF holds selectable text, not an image of it.",
  },
  {
    q: "Does Tailory work offline?",
    a: "Not reliably. The editor doesn’t need a server once it has loaded, but Tailory isn’t built as an offline app.",
  },
  {
    q: "Which browsers work?",
    a: "Current Chrome, Edge, Firefox, and Safari. Phones work too, but editing is easier on a wider screen.",
  },
];
---

<MarketingLayout
  title="FAQ"
  description="Answers about Tailory: where your resume is stored, which files it imports, JSON Resume support, templates, and browsers."
>
  <PageIntro title="FAQ" />
  <div class="mx-auto max-w-page px-gutter pb-16 md:px-gutter-wide md:pb-24">
    {
      faqs.map((item) => (
        <ProseSection title={item.q}>
          <p>{item.a}</p>
        </ProseSection>
      ))
    }
    <ProseSection title="Something else?">
      <p>
        <a href={`${repoUrl}/issues`} target="_blank" rel="noopener noreferrer">Open an issue on
        GitHub</a>.
      </p>
    </ProseSection>
  </div>
</MarketingLayout>
