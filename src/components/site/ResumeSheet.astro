---
// Renders a resume with the editor's own template code (static HTML, no client JS).
// The sheet keeps the preview's 680px page width and is scaled down with --sheet-scale.
import ResumeDocument from "@/components/resume/ResumeDocument";
import {
  RESUME_PREVIEW_FONT_FAMILY,
  RESUME_PREVIEW_PAGE_MIN_HEIGHT,
  resolveResumeDesignSettings,
} from "@/lib/resume/design";
import { TEMPLATE_REGISTRY } from "@/lib/templates/registry";
import { createSampleResume } from "@/lib/templates/sample-resume";
import type { TemplateId } from "@/types/template";

const PAGE_WIDTH = 680;

interface Props {
  template?: TemplateId;
  class?: string;
  /** Replace the title line, to show a copy of the sample tailored for another role. */
  jobTitle?: string;
}

const { template = "modern", class: className, jobTitle } = Astro.props;
const design = resolveResumeDesignSettings({ template });
const resume = createSampleResume();
if (jobTitle) resume.basics.label = jobTitle;
const label = `${resume.basics.name}'s sample resume in the ${TEMPLATE_REGISTRY[template].label} template`;
---

<div class:list={["resume-sheet", className]} role="img" aria-label={label}>
  <div
    aria-hidden="true"
    class="resume-sheet__page resume-document__page bg-sheet p-10 text-xs leading-relaxed"
    style={{
      "font-family": RESUME_PREVIEW_FONT_FAMILY,
      width: `${PAGE_WIDTH}px`,
      height: `${RESUME_PREVIEW_PAGE_MIN_HEIGHT}px`,
    }}
  >
    <ResumeDocument design={design} resume={resume} />
  </div>
</div>

<style>
  .resume-sheet {
    --sheet-scale: 0.5;
    position: relative;
    width: calc(680px * var(--sheet-scale));
    height: calc(842px * var(--sheet-scale));
    overflow: hidden;
    border-radius: var(--radius-sheet);
    background: var(--color-sheet);
    outline: 1px solid var(--color-edge);
    box-shadow: var(--shadow-sheet);
  }

  .resume-sheet__page {
    transform: scale(var(--sheet-scale));
    transform-origin: top left;
    overflow: hidden;
  }
</style>
