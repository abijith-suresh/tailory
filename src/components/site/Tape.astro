---
// A short length of tailor's tape that marks one inch. Decorative; the 404 page uses it.
interface Props {
  class?: string;
  /** The inch to mark. It sits one inch in from the tape's left end. */
  mark: number;
}

const { class: className, mark } = Astro.props;
---

<div class:list={["tape", className]} aria-hidden="true">
  <span class="tape__mark">{mark}</span>
</div>

<style>
  /* Inch, half, quarter and eighth ticks on both edges, phased so an inch line falls on the mark. */
  .tape {
    --inch: 6rem;
    --tick: var(--color-on-accent);
    --tick-line: linear-gradient(to right, var(--tick) 1px, transparent 1px);
    position: relative;
    height: 2.5rem;
    overflow: clip;
    border: 1px solid var(--color-accent-edge);
    border-radius: var(--radius-xs);
    background-color: var(--color-accent);
    background-image:
      var(--tick-line), var(--tick-line), var(--tick-line), var(--tick-line), var(--tick-line),
      var(--tick-line), var(--tick-line), var(--tick-line);
    background-size:
      var(--inch) 42%,
      var(--inch) 42%,
      calc(var(--inch) / 2) 30%,
      calc(var(--inch) / 2) 30%,
      calc(var(--inch) / 4) 20%,
      calc(var(--inch) / 4) 20%,
      calc(var(--inch) / 8) 12%,
      calc(var(--inch) / 8) 12%;
    background-position-x: var(--inch);
    background-position-y: 0, 100%, 0, 100%, 0, 100%, 0, 100%;
    background-repeat: repeat-x;
  }

  .tape__mark {
    position: absolute;
    top: 50%;
    left: var(--inch);
    translate: 0 -50%;
    padding: var(--spacing) calc(var(--spacing) * 2);
    background: var(--color-on-accent);
    font-size: var(--text-ui-sm);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }
</style>
