---
// Static hero: one real render of the sample resume, at the editor's page size where it fits,
// with crop marks at its corners. A later change animates this; it can replace the component.
import ResumeSheet from "@/components/site/ResumeSheet.astro";
---

<figure class="hero-sheet">
  <div class="crop-marks">
    <ResumeSheet template="modern" class="hero-sheet__page" />
  </div>
  <figcaption class="mt-6 text-center text-meta text-ink-subtle">
    A sample resume, drawn by the same code as the editor’s preview.
  </figcaption>
</figure>

<style>
  .hero-sheet {
    width: calc(680px * var(--page-scale));
    margin-inline: auto;
  }

  .hero-sheet :global(.hero-sheet__page) {
    --sheet-scale: var(--page-scale);
  }
</style>
