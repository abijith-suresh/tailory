---
// Static hero image: one real render of the sample resume, at the editor's page size where it
// fits, with crop marks at its corners.
import ResumeSheet from "@/components/site/ResumeSheet.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["hero-sheet crop-marks w-fit", className]}>
  <ResumeSheet template="modern" class="hero-sheet__page" />
</div>

<style>
  .hero-sheet :global(.hero-sheet__page) {
    --sheet-scale: var(--page-scale);
    box-shadow: none;
  }
</style>
