---
// Static hero: a real resume render with a tape measure laid across its foot. The tape is to
// scale with the 8.5-inch page, starts at its left edge and runs off the screen, so the page
// must clip it (overflow-x: clip). A later change animates this; it can replace the component.
import ResumeSheet from "@/components/site/ResumeSheet.astro";
import Tape from "@/components/site/Tape.astro";
---

<div class="hero-visual">
  <ResumeSheet class="hero-visual__sheet" template="modern" />
  <Tape class="hero-visual__tape" length={60} />
</div>

<style>
  .hero-visual {
    --sheet-scale: 0.42;
    /* The sheet is 8.5 inches wide. */
    --tape-inch: calc(680px * var(--sheet-scale) / 8.5);
    --tape-gap: 2.5rem;
    position: relative;
    justify-self: start;
    padding-bottom: var(--tape-gap);
  }

  .hero-visual :global(.hero-visual__sheet) {
    --sheet-scale: inherit;
  }

  /*
   * The tape's end cap hooks over the page's left edge, so 0 sits on the edge. It crosses the
   * blank foot of the page, below the resume's last line.
   */
  .hero-visual :global(.hero-visual__tape) {
    position: absolute;
    bottom: calc(var(--tape-gap) - 1rem);
    left: -0.3125rem;
    width: 240rem;
    height: 2.25rem;
    transform: rotate(-3deg);
    transform-origin: 0 50%;
  }

  @media (min-width: 24rem) {
    .hero-visual {
      --sheet-scale: 0.5;
    }
  }

  @media (min-width: 40rem) {
    .hero-visual {
      --sheet-scale: 0.7;
      --tape-gap: 3.5rem;
    }
    .hero-visual :global(.hero-visual__tape) {
      height: 2.75rem;
      bottom: calc(var(--tape-gap) - 1.25rem);
      transform: rotate(-2.5deg);
    }
  }

  @media (min-width: 64rem) {
    .hero-visual {
      --sheet-scale: 0.64;
    }
  }

  @media (min-width: 80rem) {
    .hero-visual {
      --sheet-scale: 0.74;
    }
  }
</style>
