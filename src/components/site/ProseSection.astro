---
// One titled block of a text page: the title in the left column, the text on the right. Paragraphs
// stop at the measure.
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section
  class="split border-b border-line py-6 last:border-b-0 md:items-baseline"
  id={id}
>
  <h2 class="text-heading-6 text-balance">{title}</h2>
  <div class="prose-section space-y-3 text-body-md text-fg-muted">
    <slot />
  </div>
</section>

<style>
  .prose-section :global(p) {
    max-width: var(--container-measure);
    text-wrap: pretty;
  }

  .prose-section :global(a) {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 150ms;
  }

  .prose-section :global(a:hover) {
    text-decoration-color: var(--color-primary);
  }
</style>
