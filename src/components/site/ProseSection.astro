---
// One titled block of a text page: the title in the left column, the text on the right.
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section
  class="grid gap-2 border-b border-rule py-7 md:grid-cols-[17rem_minmax(0,1fr)] md:gap-10 md:py-8"
  id={id}
>
  <h2 class="font-serif text-title font-medium text-balance">{title}</h2>
  <div class="prose-section max-w-measure space-y-3 text-body text-ink-muted md:pt-0.5">
    <slot />
  </div>
</section>

<style>
  .prose-section :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 150ms;
  }

  .prose-section :global(a:hover) {
    text-decoration-color: var(--color-accent-ink);
  }
</style>
