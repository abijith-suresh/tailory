---
// One titled block of a text page: the title in the left column, the text on the right. Paragraphs
// stop at the measure; lists and tables use the whole column.
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section
  class="grid gap-2 border-b border-rule py-6 last:border-b-0 md:grid-cols-[minmax(0,--spacing(72))_minmax(0,1fr)] md:items-baseline md:gap-10 lg:grid-cols-[minmax(0,var(--container-rail))_minmax(0,1fr)]"
  id={id}
>
  <h2 class="text-heading-6 text-balance">{title}</h2>
  <div class="prose-section space-y-3 text-body-md text-ink">
    <slot />
  </div>
</section>

<style>
  .prose-section :global(p) {
    max-width: var(--container-measure);
    text-wrap: pretty;
  }

  .prose-section :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 150ms;
  }

  .prose-section :global(a:hover) {
    text-decoration-color: var(--color-accent-ink);
  }
</style>
