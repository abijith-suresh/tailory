---
interface Props {
  class?: string;
  /** Hide the wordmark on very narrow screens, leaving the mark. */
  compact?: boolean;
}

const { class: className, compact = false } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2 text-ink", className]}>
  <!-- A T cut from tape, with the tape's metal end at its foot. -->
  <svg viewBox="0 0 32 32" aria-hidden="true" class="size-7 shrink-0">
    <path d="M3 3h26v8.5h-8.5V26h-9V11.5H3z" class="fill-accent"></path>
    <path d="M10 25.5h12V29a1 1 0 0 1-1 1H11a1 1 0 0 1-1-1z" class="fill-ink"></path>
  </svg>
  <span
    class:list={[
      "text-heading-5",
      { "max-[22.5rem]:sr-only": compact },
    ]}>Tailory</span
  >
</span>
