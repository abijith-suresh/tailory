---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5 text-ink", className]}>
  <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <rect width="32" height="32" rx="3" class="fill-accent"></rect>
    <path
      d="M7 7h18v5.5h-1.6l-.7-2.6h-4.9V23l2.7.6V25H11.5v-1.4l2.7-.6V9.9H9.3l-.7 2.6H7z"
      class="fill-on-accent"></path>
  </svg>
  <span class="font-serif text-[1.5rem] leading-none font-medium tracking-[-0.01em]">Tailory</span>
</span>
