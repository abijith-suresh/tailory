---
interface Props {
  class?: string;
  /** Hide the wordmark on the narrowest phones, leaving the mark. */
  compact?: boolean;
}

const { class: className, compact = false } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2 text-fg", className]}>
  <svg viewBox="-1 0 22 22" aria-hidden="true" class="size-6 shrink-0">
    <path d="M1 2h18v5h-6v13H7V7H1z" class="fill-primary"></path>
  </svg>
  <span class:list={["text-heading-6", { "max-[22.5rem]:sr-only": compact }]} translate="no">Tailory</span>
</span>
